# Rename this file to .env and fill in real values before running

# Your MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/zipshare

# Password required to log in as admin on the website
ADMIN_PASSWORD=changeThisPassword123

# Secret used to sign admin session tokens - use a long random string
JWT_SECRET=changeThisToARandomLongString

# Port the server listens on (Render sets this automatically)
PORT=5000
